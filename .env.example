# Copy to .env and fill in before the first start. .env is git-ignored.
#
#   cp .env.example .env

# ── Required ────────────────────────────────────────────────────────────
# Database passwords. No defaults on purpose: a shipped default would be the
# same password on every installation in the world, guarding a database that
# holds credentials for your firewalls.
#   openssl rand -base64 24
#
# Root is for administration only. The application connects as the
# unprivileged account below, which holds rights on its own schema and
# nothing else.
DB_ROOT_PASSWORD=
DB_PASSWORD=

# ── Recommended ─────────────────────────────────────────────────────────
# Encrypts stored device credentials at rest (Fernet): API keys, Gaia
# passwords and VPN pre-shared keys. Unset, credentials are stored
# unencrypted, PSK storage is disabled and pushes fall back to the
# placeholder. Losing or rotating this key makes already-stored secrets
# undecryptable.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GATESHIFT_SECRET_KEY=

# ── Optional ────────────────────────────────────────────────────────────
# Application database account and schema. Created by MariaDB on first start
# of an empty data volume. Changing either afterwards means creating the user
# by hand (GRANT ALL ON <schema>.*, never on *.*).
#DB_USER=gateshift
#DB_NAME=gateshift

# Compose project name. Determines container names, which the web UI uses to
# reach the python sidecar for syslog flow discovery. Change it and the
# discovery loses its sidecar.
COMPOSE_PROJECT_NAME=gateshift

# Address the web UI listens on: HTTPS on 443, HTTP on 80 (redirect only).
# All addresses by default: the UI has its own login. Set one address to
# restrict it to that interface.
#WEBUI_BIND=10.0.0.5

# Interface the syslog receiver binds to (default: all).
#SYSLOG_BIND=0.0.0.0
