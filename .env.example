# Copy to .env and fill in before the first start. .env is git-ignored.
#
#   cp .env.example .env

# ── Required ────────────────────────────────────────────────────────────
# Database passwords. No defaults on purpose: a shipped default would be the
# same password on every installation in the world, guarding a database that
# holds credentials for your firewalls.
#   openssl rand -base64 24
#
# Root is for administration only. The application connects as the
# unprivileged account below, which holds rights on its own schema and
# nothing else.
DB_ROOT_PASSWORD=
DB_PASSWORD=

# ── Recommended ─────────────────────────────────────────────────────────
# Encrypts stored secrets at rest (Fernet): the API keys and passwords of
# the Devices, VPN pre-shared keys and the private keys of VPN identity
# certificates. Unset, Device credentials are stored unencrypted, pre-shared
# keys and certificate keys cannot be stored and a VPN push falls back to a
# placeholder key. Losing or rotating this key makes already-stored secrets
# undecryptable. The value must be a Fernet key (44 characters). A value that
# is set but is no Fernet key stops the start.
#   openssl rand 32 | base64 | tr '+/' '-_'
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GATESHIFT_SECRET_KEY=

# ── Optional ────────────────────────────────────────────────────────────
# Application database account and schema. Created by MariaDB on first start
# of an empty data volume. Changing either afterwards means creating the user
# by hand (GRANT ALL ON <schema>.*, never on *.*).
#DB_USER=gateshift
#DB_NAME=gateshift

# Compose project name. It names the containers and the database volume.
# docker-compose.yml derives from it the name of the python sidecar, in which
# the web UI runs the ruleset pipeline and the syslog flow discovery through
# the Docker socket. Changed on an existing installation, the stack starts on
# a new, empty database.
COMPOSE_PROJECT_NAME=gateshift

# Address the web UI listens on: HTTPS on 443, HTTP on 80 (redirect only).
# All addresses by default: the UI has its own login. Set one address to
# restrict it to that interface.
#WEBUI_BIND=10.0.0.5

# Interface the syslog receiver binds to (default: all).
#SYSLOG_BIND=0.0.0.0

# 1 (or true, yes, on) offers an AI client only the reading tools of the MCP
# endpoint (/mcp). Unset or any other value offers every tool.
#GATESHIFT_MCP_READ_ONLY=1
